<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="L'EstamiTech est un podcast par Ludovic Borie. Chaque épisode met en avant un projet, une initiative dont nous pouvons discuter tech dans la bonne humeur et sans langue de bois.">
    <meta name="keywords" content="podcast, tech, nord, estaminet, ludovic borie, estamitech, l'estamitech, haut-de-france, french tech">
    <meta name="author" content="Ludovic Borie">
    <meta name="robots" content="index, follow">
    <meta name="googlebot" content="index, follow">
    <meta name="theme-color" content="#0b0a14">
    <meta property="og:title" content="L'EstamiTech">
    <meta property="og:description" content="L'EstamiTech est un podcast par Ludovic Borie. Chaque épisode met en avant un projet, une initiative dont nous pouvons discuter tech dans la bonne humeur et sans langue de bois.">
    <meta property="og:image" content="/static/LogoEstamitech.jpg">
    <meta property="og:url" content="https://estamitech.fr">
    <meta property="og:type" content="website">
    <meta property="og:locale" content="fr_FR">
    <meta property="og:site_name" content="L'EstamiTech">
    <link rel="canonical" href="https://estamitech.fr/">
    <link rel="icon" type="image/x-icon" href="/static/favicon.ico">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.1/css/all.min.css">
    <link rel="stylesheet" href="/style.css">
    <title>L'EstamiTech — La Tech du Nord</title>

    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "PodcastSeries",
      "name": "L'EstamiTech",
      "description": "L'EstamiTech est un podcast par Ludovic Borie. Chaque épisode met en avant un projet, une initiative dont nous pouvons discuter tech dans la bonne humeur et sans langue de bois.",
      "url": "https://estamitech.fr",
      "image": "https://estamitech.fr/static/LogoEstamitech.jpg",
      "author": {
        "@type": "Person",
        "name": "Ludovic Borie"
      },
      "publisher": {
        "@type": "Organization",
        "name": "L'EstamiTech",
        "logo": {
          "@type": "ImageObject",
          "url": "https://estamitech.fr/static/estamitech-icon.png"
        }
      },
      "inLanguage": "fr-FR",
      "genre": ["Technology", "Education"],
      "keywords": "podcast, tech, nord, estaminet, ludovic borie, estamitech, haut-de-france, french tech"
    }
    </script>
</head>
<body>

<!-- Nav -->
<nav class="nav">
    <a href="/" class="nav__brand">
        <img src="/static/estamitech-icon.png" alt="L'EstamiTech" class="nav__icon">
        <span class="nav__wordmark">L'ESTAMI<span class="wm-tech">TECH</span></span>
    </a>
    <div class="nav__links" id="nav-links">
        <a href="#about">À propos</a>
        <a href="#episodes">Épisodes</a>
    </div>
    <button type="button" class="nav__toggle" aria-label="Menu" aria-expanded="false" aria-controls="nav-links">
        <span></span>
        <span></span>
        <span></span>
    </button>
</nav>

<main>
<!-- Hero -->
<section class="hero">
    <!-- Sparkles — matching the 3 stars above the cauldron in the logo -->
    <div class="sparkle sparkle--1"></div>
    <div class="sparkle sparkle--2"></div>
    <div class="sparkle sparkle--3"></div>
    <div class="sparkle sparkle--4"></div>
    <div class="sparkle sparkle--5"></div>

    <div class="hero__inner">
        <div class="hero__logo">
            <img src="/static/LogoEstamitech.jpg" alt="Logo L'EstamiTech — Cauldron with sparkles">
        </div>
        <h1 class="hero__title">L'ESTAMI<span class="wm-tech">TECH</span></h1>
        <p class="hero__tagline">La Tech du Nord</p>
        <hr class="hero__rule">
        <p class="hero__credit">Podcast par Ludovic Borie</p>
    </div>

    <div class="hero__scroll">
        <span>Découvrir</span>
        <div class="hero__scroll-line"></div>
    </div>
</section>

<!-- About -->
<section class="about container" id="about">
    <div class="section-hdr reveal">
        <h2 class="label">À propos</h2>
    </div>

    <div class="about__grid">
        <div class="about__card reveal reveal-delay-1">
            <div class="about__text">
                <h3>Le podcast qui met la tech du Nord à l'honneur.</h3>
                <p>L'EstamiTech est un podcast par Ludovic Borie.</p>
                <p>Chaque épisode met en avant un projet, une initiative dont nous pouvons discuter dans la bonne humeur et sans langue de bois.</p>
                <p>Si vous souhaitez participer à l'émission, n'hésitez pas à me contacter sur l'un des réseaux sociaux ci-dessous.</p>
            </div>

            <div class="socials">
                <a href="https://www.linkedin.com/in/ludovicborie/"><i aria-hidden="true" class="fab fa-linkedin"></i> LinkedIn</a>
                <a href="https://piaille.fr/@bodul"><i aria-hidden="true" class="fab fa-mastodon"></i> Mastodon</a>
                <a href="https://twitter.com/ludovicborie"><i aria-hidden="true" class="fab fa-twitter"></i> Twitter</a>
                <a href="https://www.instagram.com/estamitech/"><i aria-hidden="true" class="fab fa-instagram"></i> Instagram</a>
                <a href="https://www.youtube.com/@EstamiTech"><i aria-hidden="true" class="fab fa-youtube"></i> YouTube</a>
                <a href="https://www.tiktok.com/@estamitech"><i aria-hidden="true" class="fab fa-tiktok"></i> TikTok</a>
                <a href="https://bsky.app/profile/estamitech.bsky.social"><i aria-hidden="true" class="fab fa-bluesky"></i> Bluesky</a>
            </div>

            <div class="platforms">
                <a href="https://podcasts.apple.com/us/podcast/lestamitech/id1752308502?itsct=podcast_box_badge&amp;itscg=30200&amp;ls=1">
                    <img src="https://tools.applemediaservices.com/api/badges/listen-on-apple-podcasts/badge/fr-fr?size=250x83&amp;releaseDate=1725395040" alt="Écouter sur Apple Podcasts">
                </a>
                <a href="https://open.spotify.com/show/1308v72DAlbYP13TA5au1I">
                    <img src="/static/spotify-podcast-badge-blk-grn-165x40.png" alt="Écouter sur Spotify">
                </a>
                <button class="rss-btn" onclick="copyRSSLink()" title="Copier le lien RSS">
                    <i aria-hidden="true" class="fas fa-rss"></i>
                    <span>RSS</span>
                </button>
            </div>
        </div>

        <div class="map-card reveal reveal-delay-2" id="recommendations">
            <h3>Les invités vous recommandent</h3>
            <div class="map-wrap">
                <iframe title="Carte des lieux recommandés par les invités du podcast" allowfullscreen allow="geolocation" src="//framacarte.org/fr/map/estamitech_196450?scaleControl=false&miniMap=false&scrollWheelZoom=false&zoomControl=true&editMode=disabled&moreControl=true&searchControl=null&tilelayersControl=null&embedControl=null&datalayersControl=true&onLoadPanel=none&captionBar=false&captionMenus=true"></iframe>
            </div>
            <div class="map-link">
                <a href="//framacarte.org/fr/map/estamitech_196450?scaleControl=false&miniMap=false&scrollWheelZoom=true&zoomControl=true&editMode=disabled&moreControl=true&searchControl=null&tilelayersControl=null&embedControl=null&datalayersControl=true&onLoadPanel=none&captionBar=false&captionMenus=true">
                    <i aria-hidden="true" class="fas fa-external-link-alt"></i> Voir en plein écran
                </a>
            </div>
        </div>
    </div>
</section>

<!-- Episodes -->
<section class="episodes container" id="episodes">
    <div class="section-hdr reveal">
        <h2 class="label">Épisodes</h2>
    </div>

    {{range $i, $ep := .Episodes}}
    {{if eq $i 0}}
    <article class="ep-featured reveal">
        <div class="ep-featured__img">
            <a href="/episode/{{$ep.GUID}}"><img src="{{$ep.Image.Href}}" alt="{{$ep.Title}}"></a>
        </div>
        <div class="ep-featured__body">
            <span class="label">Dernier épisode</span>
            <h3><a href="/episode/{{$ep.GUID}}">{{$ep.Title}}</a></h3>
            <time>{{$ep.FormattedDate}}</time>
            <p>{{$ep.CleanDesc}}</p>
            <a href="/episode/{{$ep.GUID}}" class="ep-link">Écouter l'épisode <span>→</span></a>
        </div>
    </article>
    {{else}}
    {{if eq $i 1}}<div class="ep-grid">{{end}}
    <article class="ep-card reveal">
        <a href="/episode/{{$ep.GUID}}" class="ep-card__img">
            <img src="{{$ep.Image.Href}}" alt="{{$ep.Title}}">
        </a>
        <div class="ep-card__body">
            <time>{{$ep.FormattedDate}}</time>
            <h3><a href="/episode/{{$ep.GUID}}">{{$ep.Title}}</a></h3>
            <p>{{$ep.CleanDesc}}</p>
            <a href="/episode/{{$ep.GUID}}" class="ep-link">Écouter <span>→</span></a>
        </div>
    </article>
    {{end}}
    {{end}}
    {{if gt (len .Episodes) 1}}</div>{{end}}
</section>
</main>

<!-- Footer -->
<footer class="footer">
    <div class="container">
        <img src="/static/estamitech-icon.png" alt="L'EstamiTech" class="footer__icon">
        <p class="footer__name">L'ESTAMI<span class="wm-tech">TECH</span> — La Tech du Nord</p>
        <div class="footer__links">
            <a href="https://www.linkedin.com/in/ludovicborie/"><i aria-hidden="true" class="fab fa-linkedin"></i> LinkedIn</a>
            <a href="https://piaille.fr/@bodul"><i aria-hidden="true" class="fab fa-mastodon"></i> Mastodon</a>
            <a href="https://twitter.com/ludovicborie"><i aria-hidden="true" class="fab fa-twitter"></i> Twitter</a>
            <a href="https://www.instagram.com/estamitech/"><i aria-hidden="true" class="fab fa-instagram"></i> Instagram</a>
            <a href="https://www.youtube.com/@EstamiTech"><i aria-hidden="true" class="fab fa-youtube"></i> YouTube</a>
            <a href="https://www.tiktok.com/@estamitech"><i aria-hidden="true" class="fab fa-tiktok"></i> TikTok</a>
            <a href="https://bsky.app/profile/estamitech.bsky.social"><i aria-hidden="true" class="fab fa-bluesky"></i> Bluesky</a>
        </div>
        <p class="footer__copy">&copy; {{.CurrentYear}} L'EstamiTech — Tous droits réservés — Logo réalisé par Lucille FOLENS HENNART</p>
    </div>
</footer>

<!-- Back to top -->
<a href="#" id="back-to-top" class="back-to-top" aria-label="Retour en haut">
    <i aria-hidden="true" class="fas fa-arrow-up"></i>
</a>

<script src="/script.js"></script>
</body>
</html>