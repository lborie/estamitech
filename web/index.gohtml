  <symbol id="i-rss" viewBox="0 0 448 512"><path fill="currentColor" d="M0 64C0 46.3 14.3 32 32 32c229.8 0 416 186.2 416 416c0 17.7-14.3 32-32 32s-32-14.3-32-32C384 253.6 226.4 96 32 96C14.3 96 0 81.7 0 64zM0 416a64 64 0 1 1 128 0A64 64 0 1 1 0 416zM32 160c159.1 0 288 128.9 288 288c0 17.7-14.3 32-32 32s-32-14.3-32-32c0-123.7-100.3-224-224-224c-17.7 0-32-14.3-32-32s14.3-32 32-32z"/></symbol>
  <symbol id="i-arrow-up" viewBox="0 0 384 512"><path fill="currentColor" d="M214.6 41.4c-12.5-12.5-32.8-12.5-45.3 0l-160 160c-12.5 12.5-12.5 32.8 0 45.3s32.8 12.5 45.3 0L160 141.2 160 448c0 17.7 14.3 32 32 32s32-14.3 32-32l0-306.7L329.4 246.6c12.5 12.5 32.8 12.5 45.3 0s12.5-32.8 0-45.3l-160-160z"/></symbol>
  <symbol id="i-arrow-left" viewBox="0 0 448 512"><path fill="currentColor" d="M9.4 233.4c-12.5 12.5-12.5 32.8 0 45.3l160 160c12.5 12.5 32.8 12.5 45.3 0s12.5-32.8 0-45.3L109.2 288 416 288c17.7 0 32-14.3 32-32s-14.3-32-32-32l-306.7 0L214.6 118.6c12.5-12.5 12.5-32.8 0-45.3s-32.8-12.5-45.3 0l-160 160z"/></symbol>
  <symbol id="i-external" viewBox="0 0 512 512"><path fill="currentColor" d="M352 0c-12.9 0-24.6 7.8-29.6 19.8s-2.2 25.7 6.9 34.9L370.7 96 201.4 265.4c-12.5 12.5-12.5 32.8 0 45.3s32.8 12.5 45.3 0L416 141.3l41.4 41.4c9.2 9.2 22.9 11.9 34.9 6.9s19.8-16.6 19.8-29.6l0-128c0-17.7-14.3-32-32-32L352 0zM80 32C35.8 32 0 67.8 0 112L0 432c0 44.2 35.8 80 80 80l320 0c44.2 0 80-35.8 80-80l0-112c0-17.7-14.3-32-32-32s-32 14.3-32 32l0 112c0 8.8-7.2 16-16 16L80 448c-8.8 0-16-7.2-16-16l0-320c0-8.8 7.2-16 16-16l112 0c17.7 0 32-14.3 32-32s-14.3-32-32-32L80 32z"/></symbol>
</svg>

<!-- Nav -->
<nav class="nav">
    <a href="/" class="nav__brand">
        <img src="/static/estamitech-icon.png" alt="L'EstamiTech" class="nav__icon" width="500" height="500">
        <span class="nav__wordmark">L'ESTAMI<span class="wm-tech">TECH</span></span>
    </a>
    <div class="nav__links" id="nav-links">
        <a href="#about">À propos</a>
        <a href="#episodes">Épisodes</a>
    </div>
    <button type="button" class="nav__toggle" aria-label="Menu" aria-expanded="false" aria-controls="nav-links">
        <span></span>
        <span></span>
        <span></span>
    </button>
</nav>

<main>
<!-- Hero -->
<section class="hero">
    <!-- Sparkles — matching the 3 stars above the cauldron in the logo -->
    <div class="sparkle sparkle--1"></div>
    <div class="sparkle sparkle--2"></div>
    <div class="sparkle sparkle--3"></div>
    <div class="sparkle sparkle--4"></div>
    <div class="sparkle sparkle--5"></div>

    <div class="hero__inner">
        <div class="hero__logo">
            <img src="/static/LogoEstamitech.jpg" alt="Logo de L'EstamiTech" width="1080" height="1080">
        </div>
        <h1 class="hero__title">L'ESTAMI<span class="wm-tech">TECH</span></h1>
        <p class="hero__tagline">La Tech du Nord</p>
        <hr class="hero__rule">
        <p class="hero__credit">Podcast par Ludovic Borie</p>
    </div>

    <div class="hero__scroll">
        <span>Découvrir</span>
        <div class="hero__scroll-line"></div>
    </div>
</section>

<!-- About -->
<section class="about container" id="about">
    <div class="section-hdr reveal">
        <h2 class="label">À propos</h2>
    </div>

    <div class="about__grid">
        <div class="about__card reveal reveal-delay-1">
            <div class="about__text">
                <h3>Le podcast qui met la tech du Nord à l'honneur.</h3>
                <p>L'EstamiTech est un podcast par Ludovic Borie.</p>
                <p>Chaque épisode met en avant un projet, une initiative dont nous pouvons discuter dans la bonne humeur et sans langue de bois.</p>
                <p>Si vous souhaitez participer à l'émission, n'hésitez pas à me contacter sur l'un des réseaux sociaux ci-dessous.</p>
            </div>

            <div class="socials">
                <a href="https://www.linkedin.com/in/ludovicborie/"><svg class="icon" aria-hidden="true"><use href="#i-linkedin"/></svg> LinkedIn</a>
                <a href="https://piaille.fr/@bodul"><svg class="icon" aria-hidden="true"><use href="#i-mastodon"/></svg> Mastodon</a>
                <a href="https://twitter.com/ludovicborie"><svg class="icon" aria-hidden="true"><use href="#i-twitter"/></svg> Twitter</a>
                <a href="https://www.instagram.com/estamitech/"><svg class="icon" aria-hidden="true"><use href="#i-instagram"/></svg> Instagram</a>
                <a href="https://www.youtube.com/@EstamiTech"><svg class="icon" aria-hidden="true"><use href="#i-youtube"/></svg> YouTube</a>
                <a href="https://www.tiktok.com/@estamitech"><svg class="icon" aria-hidden="true"><use href="#i-tiktok"/></svg> TikTok</a>
                <a href="https://bsky.app/profile/estamitech.bsky.social"><svg class="icon" aria-hidden="true"><use href="#i-bluesky"/></svg> Bluesky</a>
            </div>

            <div class="platforms">
                <a href="https://podcasts.apple.com/us/podcast/lestamitech/id1752308502?itsct=podcast_box_badge&amp;itscg=30200&amp;ls=1">
                    <img src="https://tools.applemediaservices.com/api/badges/listen-on-apple-podcasts/badge/fr-fr?size=250x83&amp;releaseDate=1725395040" alt="Écouter sur Apple Podcasts">
                </a>
                <a href="https://open.spotify.com/show/1308v72DAlbYP13TA5au1I">
                    <img src="/static/spotify-podcast-badge-blk-grn-165x40.png" alt="Écouter sur Spotify">
                </a>
                <button class="rss-btn" onclick="copyRSSLink()" title="Copier le lien RSS">
                    <svg class="icon" aria-hidden="true"><use href="#i-rss"/></svg>
                    <span>RSS</span>
                </button>
            </div>
        </div>

        <div class="map-card reveal reveal-delay-2" id="recommendations">
            <h3>Les invités vous recommandent</h3>
            <div class="map-wrap">
                <iframe title="Carte des lieux recommandés par les invités du podcast" allowfullscreen allow="geolocation" src="//framacarte.org/fr/map/estamitech_196450?scaleControl=false&miniMap=false&scrollWheelZoom=false&zoomControl=true&editMode=disabled&moreControl=true&searchControl=null&tilelayersControl=null&embedControl=null&datalayersControl=true&onLoadPanel=none&captionBar=false&captionMenus=true"></iframe>
            </div>
            <div class="map-link">
                <a href="//framacarte.org/fr/map/estamitech_196450?scaleControl=false&miniMap=false&scrollWheelZoom=true&zoomControl=true&editMode=disabled&moreControl=true&searchControl=null&tilelayersControl=null&embedControl=null&datalayersControl=true&onLoadPanel=none&captionBar=false&captionMenus=true">
                    <svg class="icon" aria-hidden="true"><use href="#i-external"/></svg> Voir en plein écran
                </a>
            </div>
        </div>
    </div>
</section>

<!-- Episodes -->
<section class="episodes container" id="episodes">
    <div class="section-hdr reveal">
        <h2 class="label">Épisodes</h2>
    </div>

    {{range $i, $ep := .Episodes}}
    {{if eq $i 0}}
    <article class="ep-featured reveal">
        <div class="ep-featured__img">
            <a href="/episode/{{$ep.GUID}}"><img src="{{$ep.Image.Href}}" alt="{{$ep.Title}}" loading="lazy" decoding="async"></a>
        </div>
        <div class="ep-featured__body">
            <span class="label">Dernier épisode</span>
            <h3><a href="/episode/{{$ep.GUID}}">{{$ep.Title}}</a></h3>
            <time>{{$ep.FormattedDate}}</time>
            <p>{{$ep.CleanDesc}}</p>
            <a href="/episode/{{$ep.GUID}}" class="ep-link">Écouter l'épisode <span>→</span></a>
        </div>
    </article>
    {{else}}
    {{if eq $i 1}}<div class="ep-grid">{{end}}
    <article class="ep-card reveal">
        <a href="/episode/{{$ep.GUID}}" class="ep-card__img">
            <img src="{{$ep.Image.Href}}" alt="{{$ep.Title}}" loading="lazy" decoding="async">
        </a>
        <div class="ep-card__body">
            <time>{{$ep.FormattedDate}}</time>
            <h3><a href="/episode/{{$ep.GUID}}">{{$ep.Title}}</a></h3>
            <p>{{$ep.CleanDesc}}</p>
            <a href="/episode/{{$ep.GUID}}" class="ep-link">Écouter <span>→</span></a>
        </div>
    </article>
    {{end}}
    {{end}}
    {{if gt (len .Episodes) 1}}</div>{{end}}
</section>
</main>

<!-- Footer -->
<footer class="footer">
    <div class="container">
        <img src="/static/estamitech-icon.png" alt="L'EstamiTech" class="footer__icon" width="500" height="500" loading="lazy">
        <p class="footer__name">L'ESTAMI<span class="wm-tech">TECH</span> — La Tech du Nord</p>
        <div class="footer__links">
            <a href="https://www.linkedin.com/in/ludovicborie/"><svg class="icon" aria-hidden="true"><use href="#i-linkedin"/></svg> LinkedIn</a>
            <a href="https://piaille.fr/@bodul"><svg class="icon" aria-hidden="true"><use href="#i-mastodon"/></svg> Mastodon</a>
            <a href="https://twitter.com/ludovicborie"><svg class="icon" aria-hidden="true"><use href="#i-twitter"/></svg> Twitter</a>
            <a href="https://www.instagram.com/estamitech/"><svg class="icon" aria-hidden="true"><use href="#i-instagram"/></svg> Instagram</a>
            <a href="https://www.youtube.com/@EstamiTech"><svg class="icon" aria-hidden="true"><use href="#i-youtube"/></svg> YouTube</a>
            <a href="https://www.tiktok.com/@estamitech"><svg class="icon" aria-hidden="true"><use href="#i-tiktok"/></svg> TikTok</a>
            <a href="https://bsky.app/profile/estamitech.bsky.social"><svg class="icon" aria-hidden="true"><use href="#i-bluesky"/></svg> Bluesky</a>
        </div>
        <p class="footer__copy">&copy; {{.CurrentYear}} L'EstamiTech — Tous droits réservés — Logo réalisé par Lucille FOLENS HENNART</p>
    </div>
</footer>

<!-- Back to top -->
<a href="#" id="back-to-top" class="back-to-top" aria-label="Retour en haut">
    <svg class="icon" aria-hidden="true"><use href="#i-arrow-up"/></svg>
</a>

<script src="/script.js"></script>
</body>
</html>