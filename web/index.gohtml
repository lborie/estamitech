<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <meta name="description" content="L'Estamitech est un podcast par Ludovic Borie. Chaque épisode met en avant un projet, une initiative dont nous pouvons discuter tech dans la bonne humeur et sans langue de bois.">
    <meta name="keywords" content="podcast, tech, nord, estaminet, ludovic borie">
    <meta name="author" content="Ludovic Borie">
    <meta name="robots" content="index, follow">
    <meta name="googlebot" content="index, follow">
    <meta name="theme-color" content="#5d1692">
    <meta property="og:title" content="L'Estamitech">
    <meta property="og:description" content="L'Estamitech est un podcast par Ludovic Borie. Chaque épisode met en avant un projet, une initiative dont nous pouvons discuter tech dans la bonne humeur et sans langue de bois.">
    <meta property="og:image" content="/static/LogoEstamitech.jpg">
    <meta property="og:url" content="https://estamitech.fr">
    <meta property="og:type" content="website">
    <meta property="og:locale" content="fr_FR">
    <meta property="og:site_name" content="L'Estamitech">
    <link rel="icon" type="image/x-icon" href="/static/favicon.ico">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700&family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.1/css/all.min.css">
    <link rel="stylesheet" href="/style.css">
    <title>L'ESTAMITECH - La Tech du Nord</title>
</head>
<body>
<!-- Navbar -->
<nav class="navbar">
    <div class="navbar-logo">
        <a href="/">
            <img src="/static/LogoEstamitech.jpg" alt="Logo Estamitech">
            <h1>L'<span style="color: var(--text-light);">ESTAMI</span><span style="color: var(--accent-tech);">TECH</span></h1>
        </a>
    </div>
    <div class="navbar-links">
        <a href="#about">À propos</a>
        <a href="#episodes">Épisodes</a>
    </div>
    <div class="menu-toggle">
        <span></span>
        <span></span>
        <span></span>
    </div>
</nav>

<!-- Hero Section -->
<section class="hero">
    <div class="hero-content">
        <img src="/static/LogoEstamitech.jpg" alt="Logo Estamitech">
        <h1>L'<span style="color: var(--text-light);">ESTAMI</span><span style="color: var(--accent-tech);">TECH</span></h1>
        <h2>La Tech du Nord</h2>
    </div>
</section>

<!-- Main Content -->
<section class="main-content" id="about">
    <h2 class="section-title">À propos</h2>
    <div class="grid-container">
        <div class="card description-card">
            <div class="card-content">
                <h3>Le podcast qui met la tech du Nord à l'honneur.</h3>
                <p>L'Estamitech est un podcast par Ludovic Borie.</p>
                <p>Chaque épisode met en avant un projet, une initiative dont nous pouvons discuter dans la bonne humeur et sans langue de bois.</p>
                <p>Si vous souhaitez participer à l'émission, n'hésitez pas à me contacter sur l'un des réseaux sociaux ci-dessous.</p>

                <div class="social-links">
                <a href="https://www.linkedin.com/in/ludovicborie/" class="social-btn">
                <i class="fab fa-linkedin"></i> LinkedIn
                </a>
                <a href="https://piaille.fr/@bodul" class="social-btn">
                <i class="fab fa-mastodon"></i> Mastodon
                </a>
                <a href="https://twitter.com/ludovicborie" class="social-btn">
                <i class="fab fa-twitter"></i> Twitter
                </a>
                    <a href="https://www.instagram.com/estamitech/" class="social-btn">
                            <i class="fab fa-instagram"></i> Instagram
                        </a>
                        <a href="https://www.youtube.com/@EstamiTech" class="social-btn">
                            <i class="fab fa-youtube"></i> YouTube
                        </a>
                        <a href="https://www.tiktok.com/@estamitech" class="social-btn">
                            <i class="fab fa-tiktok"></i> TikTok
                        </a>
                        <a href="https://bsky.app/profile/estamitech.bsky.social" class="social-btn">
                            <i class="fab fa-bluesky"></i> Bluesky
                        </a>
                    </div>

                <div class="podcast-links">
                    <a href="https://podcasts.apple.com/us/podcast/lestamitech/id1752308502?itsct=podcast_box_badge&amp;itscg=30200&amp;ls=1">
                        <img src="https://tools.applemediaservices.com/api/badges/listen-on-apple-podcasts/badge/fr-fr?size=250x83&amp;releaseDate=1725395040" alt="Listen on Apple Podcasts" style="height: 40px;">
                    </a>
                    <a href="https://open.spotify.com/show/1308v72DAlbYP13TA5au1I">
                        <img src="/static/spotify-podcast-badge-blk-grn-165x40.png" alt="Listen on Spotify" style="height: 40px;">
                    </a>
                    <button class="rss-btn" onclick="copyRSSLink()" title="Copier le lien RSS">
                        <i class="fas fa-rss"></i>
                        <span>RSS</span>
                    </button>
                </div>
            </div>
        </div>

        <div class="card" id="recommendations">
            <div class="card-content">
                <div class="map-container">
                    <h3>Les invités vous recommandent :</h3>
                    <div class="map-wrapper">
                        <iframe allowfullscreen allow="geolocation" src="//framacarte.org/fr/map/estamitech_196450?scaleControl=false&miniMap=false&scrollWheelZoom=false&zoomControl=true&editMode=disabled&moreControl=true&searchControl=null&tilelayersControl=null&embedControl=null&datalayersControl=true&onLoadPanel=none&captionBar=false&captionMenus=true"></iframe>
                    </div>
                    <div class="map-link">
                        <a href="//framacarte.org/fr/map/estamitech_196450?scaleControl=false&miniMap=false&scrollWheelZoom=true&zoomControl=true&editMode=disabled&moreControl=true&searchControl=null&tilelayersControl=null&embedControl=null&datalayersControl=true&onLoadPanel=none&captionBar=false&captionMenus=true">
                            <i class="fas fa-external-link-alt"></i> Voir en plein écran
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Episodes Section -->
<section class="episodes-section" id="episodes">
    <h2 class="section-title">Épisodes</h2>
    <div class="episodes-container">
        {{range .Episodes}}
        <div class="episode-card">
            <div class="episode-image">
                <a href="/episode/{{.GUID}}"><img src="{{.Image.Href}}" alt="Miniature de l'épisode - {{.Title}}"></a>
            </div>
            <div class="episode-details">
                <div class="episode-content-top">
                    <h3 class="episode-title"><a href="/episode/{{.GUID}}" style="text-decoration: none; color: inherit;">{{.Title}}</a></h3>
                    <div class="episode-meta">
                        <span><i class="far fa-calendar-alt"></i> {{.FormattedDate}}</span>
                    </div>
                    <div class="episode-description">{{.CleanDesc}}</div>
                </div>
                <div class="episode-actions">
                    <a href="/episode/{{.GUID}}" class="see-more-btn">
                        <i class="fas fa-eye"></i>
                        Voir plus
                    </a>
                </div>
            </div>
        </div>
        {{end}}
    </div>
</section>

<!-- Footer -->
<footer>
    <div class="footer-content">
        <div class="footer-logo">
            <img src="/static/LogoEstamitech.jpg" alt="Logo Estamitech">
        </div>
        <p>L'<span style="color: var(--text-light);">ESTAMI</span><span style="color: var(--accent-tech);">TECH</span> - La Tech du Nord</p>
        <div class="footer-links">
            <a href="https://www.linkedin.com/in/ludovicborie/"><i class="fab fa-linkedin"></i> LinkedIn</a>
            <a href="https://piaille.fr/@bodul"><i class="fab fa-mastodon"></i> Mastodon</a>
            <a href="https://twitter.com/ludovicborie"><i class="fab fa-twitter"></i> Twitter</a>
            <a href="https://www.instagram.com/estamitech/"><i class="fab fa-instagram"></i> Instagram</a>
            <a href="https://www.youtube.com/@EstamiTech"><i class="fab fa-youtube"></i> YouTube</a>
            <a href="https://www.tiktok.com/@estamitech"><i class="fab fa-tiktok"></i> TikTok</a>
            <a href="https://bsky.app/profile/estamitech.bsky.social"><i class="fab fa-bluesky"></i> Bluesky</a>
        </div>
        <div class="copyright">
            &copy; {{.CurrentYear}} L'Estamitech - Tous droits réservés
        </div>
    </div>
</footer>

<!-- Back to Top Button -->
<a href="#" id="back-to-top" class="back-to-top">
    <i class="fas fa-arrow-up"></i>
</a>

<script src="/script.js"></script>
</body>
</html>