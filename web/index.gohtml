<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="L'EstamiTech est un podcast par Ludovic Borie. Chaque épisode met en avant un projet, une initiative dont nous pouvons discuter tech dans la bonne humeur et sans langue de bois.">
    <meta name="keywords" content="podcast, tech, nord, estaminet, ludovic borie, estamitech, l'estamitech, haut-de-france, french tech">
    <meta name="author" content="Ludovic Borie">
    <meta name="robots" content="index, follow">
    <meta name="googlebot" content="index, follow">
    <meta name="theme-color" content="#0b0a14">
    <meta property="og:title" content="L'EstamiTech">
    <meta property="og:description" content="L'EstamiTech est un podcast par Ludovic Borie. Chaque épisode met en avant un projet, une initiative dont nous pouvons discuter tech dans la bonne humeur et sans langue de bois.">
    <meta property="og:image" content="https://estamitech.fr/og-image">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:image:type" content="image/png">
    <meta property="og:image:alt" content="L'EstamiTech — La Tech du Nord">
    <meta property="og:url" content="https://estamitech.fr/">
    <meta property="og:type" content="website">
    <meta property="og:locale" content="fr_FR">
    <meta property="og:site_name" content="L'EstamiTech">

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="L'EstamiTech — La Tech du Nord">
    <meta name="twitter:description" content="L'EstamiTech est un podcast par Ludovic Borie. Chaque épisode met en avant un projet, une initiative dont nous pouvons discuter tech dans la bonne humeur et sans langue de bois.">
    <meta name="twitter:image" content="https://estamitech.fr/og-image">
    <meta name="twitter:image:alt" content="L'EstamiTech — La Tech du Nord">

    <link rel="canonical" href="https://estamitech.fr/">
    <link rel="alternate" type="application/rss+xml" title="L'EstamiTech — Flux du podcast" href="https://feeds.zencastr.com/f/bOMlUWx6.rss">
    <link rel="icon" type="image/x-icon" href="/static/favicon.ico">
    <link rel="stylesheet" href="/style.css">
    <title>L'EstamiTech — La Tech du Nord</title>

    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "PodcastSeries",
      "name": "L'EstamiTech",
      "description": "L'EstamiTech est un podcast par Ludovic Borie. Chaque épisode met en avant un projet, une initiative dont nous pouvons discuter tech dans la bonne humeur et sans langue de bois.",
      "url": "https://estamitech.fr/",
      "image": "https://estamitech.fr/static/LogoEstamitech.jpg",
      "author": {
        "@type": "Person",
        "name": "Ludovic Borie"
      },
      "publisher": {
        "@type": "Organization",
        "name": "L'EstamiTech",
        "logo": {
          "@type": "ImageObject",
          "url": "https://estamitech.fr/static/estamitech-icon.png"
        }
      },
      "inLanguage": "fr-FR",
      "genre": ["Technology", "Education"],
      "keywords": "podcast, tech, nord, estaminet, ludovic borie, estamitech, haut-de-france, french tech"
    }
    </script>
</head>
<body>
<!-- Icônes : Font Awesome Free 6 (CC BY 4.0) — https://fontawesome.com -->
<svg xmlns="http://www.w3.org/2000/svg" width="0" height="0" style="position:absolute" aria-hidden="true">
