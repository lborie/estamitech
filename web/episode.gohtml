<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <meta name="description" content="{{.CleanDesc}}">
    <meta name="keywords" content="podcast, tech, nord, estaminet, ludovic borie, épisode">
    <meta name="author" content="Ludovic Borie">
    <meta name="robots" content="index, follow">
    <meta name="googlebot" content="index, follow">
    <meta name="theme-color" content="#5d1692">
    
    <!-- Open Graph / Facebook -->
    <meta property="og:title" content="{{.Episode.Title}} - L'ESTAMITECH">
    <meta property="og:description" content="{{.CleanDesc}}">
    <meta property="og:image" content="https://estamitech.fr/og-image/{{.Episode.GUID}}">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:url" content="https://estamitech.fr/episode/{{.Episode.GUID}}">
    <meta property="og:type" content="article">
    <meta property="og:locale" content="fr_FR">
    <meta property="og:site_name" content="L'Estamitech">
    
    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{{.Episode.Title}} - L'ESTAMITECH">
    <meta name="twitter:description" content="{{.CleanDesc}}">
    <meta name="twitter:image" content="https://estamitech.fr/og-image/{{.Episode.GUID}}">
    
    <link rel="icon" type="image/x-icon" href="/static/favicon.ico">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700&family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.1/css/all.min.css">
    <link rel="stylesheet" href="/style.css">
    <title>{{.Episode.Title}} - L'ESTAMITECH</title>
</head>
<body>
<!-- Navbar -->
<nav class="navbar">
    <div class="navbar-logo">
        <a href="/">
            <img src="/static/LogoEstamitech.jpg" alt="Logo Estamitech">
            <h1>L'<span style="color: var(--text-light);">ESTAMI</span><span style="color: var(--accent-tech);">TECH</span></h1>
        </a>
    </div>
    <div class="navbar-links">
        <a href="/">Accueil</a>
        <a href="/#about">À propos</a>
        <a href="/#episodes">Épisodes</a>
    </div>
    <div class="menu-toggle">
        <span></span>
        <span></span>
        <span></span>
    </div>
</nav>

<div class="episode-container">
    <a href="/#episodes" class="back-link">
        <i class="fas fa-arrow-left"></i>
        Retour aux épisodes
    </a>
    
    <div class="episode-header">
        <h1>{{.Episode.Title}}</h1>
        <div class="episode-meta">
            <span><i class="far fa-calendar-alt"></i> {{.FormattedDate}}</span>
        </div>
    </div>
    
    <div class="episode-content">
        <div class="episode-image-container">
            <img src="{{.Episode.Image.Href}}" alt="Miniature de l'épisode - {{.Episode.Title}}">
        </div>
        
        <div class="episode-info">
            <div class="audio-player">
                <h3>Écouter l'épisode</h3>
                {{if .Episode.Enclosure.URL}}
                <audio controls>
                    <source src="{{.Episode.Enclosure.URL}}" type="audio/mpeg">
                    Votre navigateur ne supporte pas l'élément audio.
                </audio>
                {{else}}
                <audio controls>
                    <source src="{{.Episode.Link}}" type="audio/mpeg">
                    Votre navigateur ne supporte pas l'élément audio.
                </audio>
                {{end}}
                
                <div class="podcast-links">
                    <a href="https://podcasts.apple.com/us/podcast/lestamitech/id1752308502?itsct=podcast_box_badge&amp;itscg=30200&amp;ls=1">
                        <img src="https://tools.applemediaservices.com/api/badges/listen-on-apple-podcasts/badge/fr-fr?size=250x83&amp;releaseDate=1725395040" alt="Listen on Apple Podcasts" style="height: 40px;">
                    </a>
                    <a href="https://open.spotify.com/show/1308v72DAlbYP13TA5au1I">
                        <img src="/static/spotify-podcast-badge-blk-grn-165x40.png" alt="Listen on Spotify" style="height: 40px;">
                    </a>
                    <button class="rss-btn" onclick="copyRSSLink()" title="Copier le lien RSS">
                        <i class="fas fa-rss"></i>
                        <span>RSS</span>
                    </button>
                </div>
            </div>
        </div>
    </div>
    
    <div class="episode-description">
        <h3>Description</h3>
        <div>
            {{.HTMLDesc}}
        </div>
    </div>
</div>

<!-- Footer -->
<footer>
    <div class="footer-content">
        <div class="footer-logo">
            <img src="/static/LogoEstamitech.jpg" alt="Logo Estamitech">
        </div>
        <p>L'<span style="color: var(--text-light);">ESTAMI</span><span style="color: var(--accent-tech);">TECH</span> - La Tech du Nord</p>
        <div class="footer-links">
            <a href="https://www.linkedin.com/in/ludovicborie/"><i class="fab fa-linkedin"></i> LinkedIn</a>
            <a href="https://piaille.fr/@bodul"><i class="fab fa-mastodon"></i> Mastodon</a>
            <a href="https://twitter.com/ludovicborie"><i class="fab fa-twitter"></i> Twitter</a>
            <a href="https://www.instagram.com/estamitech/"><i class="fab fa-instagram"></i> Instagram</a>
            <a href="https://www.youtube.com/@EstamiTech"><i class="fab fa-youtube"></i> YouTube</a>
            <a href="https://www.tiktok.com/@estamitech"><i class="fab fa-tiktok"></i> TikTok</a>
            <a href="https://bsky.app/profile/estamitech.bsky.social"><i class="fab fa-bluesky"></i> Bluesky</a>
        </div>
        <div class="copyright">
            &copy; <span id="current-year"></span> L'Estamitech - Tous droits réservés
        </div>
    </div>
</footer>

<script src="/script.js"></script>
</body>
</html>