<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="{{.CleanDesc}}">
    <meta name="keywords" content="épisode, podcast, tech, nord, estaminet, ludovic borie, EstamiTech, l'EstamiTech, haut-de-france, french tech">
    <meta name="author" content="Ludovic Borie">
    <meta name="robots" content="index, follow">
    <meta name="googlebot" content="index, follow">
    <meta name="theme-color" content="#0b0a14">

    <!-- Open Graph / Facebook -->
    <meta property="og:title" content="{{.Episode.Title}} — L'EstamiTech">
    <meta property="og:description" content="{{.CleanDesc}}">
    <meta property="og:image" content="https://estamitech.fr/og-image/{{.Episode.GUID}}">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:image:type" content="image/png"/>
    <meta property="og:url" content="https://estamitech.fr/episode/{{.Episode.GUID}}">
    <meta property="og:type" content="article">
    <meta property="og:locale" content="fr_FR">
    <meta property="og:site_name" content="L'EstamiTech">

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{{.Episode.Title}} — L'EstamiTech">
    <meta name="twitter:description" content="{{.CleanDesc}}">
    <meta name="twitter:image" content="https://estamitech.fr/og-image/{{.Episode.GUID}}">

    <link rel="canonical" href="https://estamitech.fr/episode/{{.Episode.GUID}}">
    <link rel="icon" type="image/x-icon" href="/static/favicon.ico">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.1/css/all.min.css">
    <link rel="stylesheet" href="/style.css">
    <title>{{.Episode.Title}} — L'EstamiTech</title>

    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "PodcastEpisode",
      "name": "{{.Episode.Title}}",
      "description": "{{.CleanDesc}}",
      "url": "https://estamitech.fr/episode/{{.Episode.GUID}}",
      "datePublished": "{{.Episode.PubDate}}",
      {{if .Episode.Duration}}"duration": "{{.Episode.Duration}}",{{end}}
      {{if .Episode.Episode}}"episodeNumber": "{{.Episode.Episode}}",{{end}}
      {{if .Episode.Season}}"seasonNumber": "{{.Episode.Season}}",{{end}}
      "audio": {
        "@type": "AudioObject",
        "contentUrl": "{{.Episode.Enclosure.URL}}"{{if .Episode.Duration}},
        "duration": "{{.Episode.Duration}}"{{end}}
      },
      "partOfSeries": {
        "@type": "PodcastSeries",
        "name": "L'EstamiTech",
        "url": "https://estamitech.fr"
      },
      "image": {
        "@type": "ImageObject",
        "url": "{{.Episode.Image.Href}}"
      },
      "author": {
        "@type": "Person",
        "name": "{{if .Episode.Author}}{{.Episode.Author}}{{else}}Ludovic Borie{{end}}"
      },
      "publisher": {
        "@type": "Organization",
        "name": "L'EstamiTech",
        "logo": {
          "@type": "ImageObject",
          "url": "https://estamitech.fr/static/estamitech-icon.png"
        }
      },
      "inLanguage": "fr-FR"{{if .Episode.Keywords}},
      "keywords": "{{.Episode.Keywords}}"{{end}}
    }
    </script>
</head>
<body>

<!-- Nav -->
<nav class="nav">
    <a href="/" class="nav__brand">
        <img src="/static/estamitech-icon.png" alt="L'EstamiTech" class="nav__icon">
        <span class="nav__wordmark">L'ESTAMI<span class="wm-tech">TECH</span></span>
    </a>
    <div class="nav__links" id="nav-links">
        <a href="/">Accueil</a>
        <a href="/#about">À propos</a>
        <a href="/#episodes">Épisodes</a>
    </div>
    <button type="button" class="nav__toggle" aria-label="Menu" aria-expanded="false" aria-controls="nav-links">
        <span></span>
        <span></span>
        <span></span>
    </button>
</nav>

<!-- Episode Page -->
<main class="ep-page">
    <a href="/#episodes" class="back-link">
        <i aria-hidden="true" class="fas fa-arrow-left"></i>
        Retour aux épisodes
    </a>

    <header class="ep-page__header">
        <span class="label">Épisode</span>
        <h1>{{.Episode.Title}}</h1>
        <time>{{.FormattedDate}}</time>
    </header>

    <hr class="ep-page__rule">

    <div class="ep-page__content">
        <div class="ep-page__art">
            <img src="{{.Episode.Image.Href}}" alt="{{.Episode.Title}}">
        </div>

        <div class="ep-page__player">
            <h3>Écouter l'épisode</h3>
            {{if .Episode.Enclosure.URL}}
            <audio controls preload="metadata">
                <source src="{{.Episode.Enclosure.URL}}" type="audio/mpeg">
                Votre navigateur ne supporte pas l'élément audio.
            </audio>
            {{else}}
            <audio controls preload="metadata">
                <source src="{{.Episode.Link}}" type="audio/mpeg">
                Votre navigateur ne supporte pas l'élément audio.
            </audio>
            {{end}}

            <div class="platforms">
                <a href="https://podcasts.apple.com/us/podcast/lestamitech/id1752308502?itsct=podcast_box_badge&amp;itscg=30200&amp;ls=1">
                    <img src="https://tools.applemediaservices.com/api/badges/listen-on-apple-podcasts/badge/fr-fr?size=250x83&amp;releaseDate=1725395040" alt="Écouter sur Apple Podcasts">
                </a>
                <a href="https://open.spotify.com/show/1308v72DAlbYP13TA5au1I">
                    <img src="/static/spotify-podcast-badge-blk-grn-165x40.png" alt="Écouter sur Spotify">
                </a>
                <button class="rss-btn" onclick="copyRSSLink()" title="Copier le lien RSS">
                    <i aria-hidden="true" class="fas fa-rss"></i>
                    <span>RSS</span>
                </button>
            </div>
        </div>
    </div>

    <div class="ep-page__desc">
        <h3>Description</h3>
        <div>{{.HTMLDesc}}</div>
    </div>
</main>

<!-- Footer -->
<footer class="footer">
    <div class="container">
        <img src="/static/estamitech-icon.png" alt="L'EstamiTech" class="footer__icon">
        <p class="footer__name">L'ESTAMI<span class="wm-tech">TECH</span> — La Tech du Nord</p>
        <div class="footer__links">
            <a href="https://www.linkedin.com/in/ludovicborie/"><i aria-hidden="true" class="fab fa-linkedin"></i> LinkedIn</a>
            <a href="https://piaille.fr/@bodul"><i aria-hidden="true" class="fab fa-mastodon"></i> Mastodon</a>
            <a href="https://twitter.com/ludovicborie"><i aria-hidden="true" class="fab fa-twitter"></i> Twitter</a>
            <a href="https://www.instagram.com/estamitech/"><i aria-hidden="true" class="fab fa-instagram"></i> Instagram</a>
            <a href="https://www.youtube.com/@EstamiTech"><i aria-hidden="true" class="fab fa-youtube"></i> YouTube</a>
            <a href="https://www.tiktok.com/@estamitech"><i aria-hidden="true" class="fab fa-tiktok"></i> TikTok</a>
            <a href="https://bsky.app/profile/estamitech.bsky.social"><i aria-hidden="true" class="fab fa-bluesky"></i> Bluesky</a>
        </div>
        <p class="footer__copy">&copy; <span id="current-year"></span> L'EstamiTech — Tous droits réservés — Logo réalisé par Lucille FOLENS HENNART</p>
    </div>
</footer>

<script src="/script.js"></script>
</body>
</html>